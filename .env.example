# Copy this file to .env and fill in your real values.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
DB_PATH=data/feedback.db

# Demo mode: restricts the Analyze page to the bundled sample CSVs (no arbitrary
# uploads) and caps total Gemini calls per UTC day across all visitors. Intended
# for a public-facing portfolio/demo deployment, not normal local use.
DEMO_MODE=false
DEMO_DAILY_CALL_LIMIT=300
